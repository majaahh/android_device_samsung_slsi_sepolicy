allow init cpefs_block_device:lnk_file relabelto;
allow init efs_block_device:lnk_file relabelto;
allow init efs_file:dir mounton;
allow init mnt_vendor_file:dir mounton;
allow init proc_last_kmsg:file setattr;
allow init sysfs_block_writable:file { open write };
allow init vbmeta_block_device:lnk_file relabelto;
allow init vendor_firmware_file:file mounton;
