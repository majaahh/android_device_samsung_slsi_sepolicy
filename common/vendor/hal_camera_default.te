allow hal_camera_default app_efs_file:dir search;
allow hal_camera_default app_efs_file:file r_file_perms;
allow hal_camera_default { data_eden_file sysfs_npu_version }:dir r_dir_perms;
allow hal_camera_default dmabuf_camera_heap_device:chr_file r_file_perms;
allow hal_camera_default efs_file:dir search;
allow hal_camera_default hal_graphics_composer_default:fd use;
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_camera_default npu_device:chr_file rw_file_perms;
allow hal_camera_default proc_meminfo:file { open read };
allow hal_camera_default sysfs_battery:dir r_dir_perms;
allow hal_camera_default sysfs_battery:file r_file_perms;
allow hal_camera_default sysfs_camera:dir r_dir_perms;
allow hal_camera_default sysfs_camera:file r_file_perms;
allow hal_camera_default sysfs_camera_writable:file rw_file_perms;
allow hal_camera_default sysfs_npu_version:file r_file_perms;
dontaudit hal_camera_default default_prop:file r_file_perms;
get_prop(hal_camera_default, exported_camera_prop)
get_prop(hal_camera_default, vendor_radio_prop)
hal_client_domain(hal_camera_default, hal_graphics_allocator)
set_prop(hal_camera_default, vendor_camera_prop)
